#!/usr/bin/env zsh
#
# ascii icon set — 7-bit ASCII only, safe under any locale
# Hand-written (NOT generated by scripts/sync-icons.zsh): it layers over the
# generated none set, so it declares the full token set by construction, and
# gives the base vocabulary a readable ASCII glyph. Every other name stays empty.
#
# shui.zsh selects this set automatically when the locale is not UTF-8, where
# the $'\U…' escapes in every other set are a fatal "character not in range".
# Plain single-quoted literals only: no escapes, no bytes above 0x7F.
#

source "${SHUI_DIR}/src/icons/none.zsh"

SHUI_ICON_SUCCESS='+'
SHUI_ICON_ERROR='x'
SHUI_ICON_WARNING='!'
SHUI_ICON_INFO='i'
SHUI_ICON_ARROW='->'
SHUI_ICON_CHECK='+'
SHUI_ICON_CROSS='x'

SHUI_ICON_BULLET='-'
SHUI_ICON_POINTER='>'
SHUI_ICON_CIRCLE='*'
SHUI_ICON_CIRCLE_EMPTY='o'
SHUI_ICON_SQUARE='#'
SHUI_ICON_SQUARE_EMPTY='.'
SHUI_ICON_DIAMOND='*'
SHUI_ICON_TRIANGLE='^'
